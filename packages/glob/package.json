{
  "name": "@rust-gear/glob",
  "version": "1.1.1",
  "description": "A fast glob alternative for Node.js powered by Rust.",
  "keywords": [
    "glob",
    "globset",
    "fast-glob",
    "fast glob",
    "glob alternative",
    "file search",
    "file matching",
    "file system",
    "directory traversal",
    "rust",
    "napi-rs",
    "node",
    "nodejs",
    "native",
    "high-performance",
    "parallel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rust-gear-project/rust-gear.git"
  },
  "license": "Apache-2.0",
  "author": "Refirst 11",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "glob",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "packages": "node ../../scripts/generate-platform-packages.js",
    "readme": "node ../../scripts/generate-platform-readme.js",
    "update:main": "node ../../scripts/update-main-package.js",
    "test": "ava",
    "bench": "node bench/bench.mjs"
  },
  "engines": {
    "node": ">=10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.3"
  }
}
