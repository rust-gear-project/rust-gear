{
  "name": "@rust-gear/glob",
  "version": "1.0.0",
  "description": "A fast glob alternative for Node.js powered by Rust.",
  "keywords": [
    "glob",
    "globset",
    "fast-glob",
    "fast glob",
    "glob alternative",
    "file search",
    "file matching",
    "file system",
    "directory traversal",
    "rust",
    "napi-rs",
    "node",
    "nodejs",
    "native",
    "high-performance",
    "parallel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rust-gear-project/rust-gear.git"
  },
  "license": "Apache-2.0",
  "author": "Refirst 11",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts"
  ],
  "napi": {
    "name": "glob",
    "triples": [
      "darwin-arm64",
      "darwin-x64",
      "linux-arm64-gnu",
      "linux-arm64-musl",
      "linux-x64-gnu",
      "linux-x64-musl",
      "win32-x64-msvc",
      "win32-ia32-msvc",
      "win32-arm64-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "packages": "node ../../scripts/generate-platform-packages.js",
    "readme": "node ../../scripts/generate-platform-readme.js",
    "update:main": "node ../../scripts/update-main-package.js",
    "test": "ava"
  },
  "engines": {
    "node": ">=10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "optionalDependencies": {
    "@rust-gear/glob-darwin-arm64": "1.0.0",
    "@rust-gear/glob-darwin-x64": "1.0.0",
    "@rust-gear/glob-linux-arm64-gnu": "1.0.0",
    "@rust-gear/glob-linux-arm64-musl": "1.0.0",
    "@rust-gear/glob-linux-x64-gnu": "1.0.0",
    "@rust-gear/glob-linux-x64-musl": "1.0.0",
    "@rust-gear/glob-win32-arm64-msvc": "1.0.0",
    "@rust-gear/glob-win32-ia32-msvc": "1.0.0",
    "@rust-gear/glob-win32-x64-msvc": "1.0.0"
  }
}
